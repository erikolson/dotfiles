#!/bin/sh
# Seeded into each repo by init.templateDir. Delegates to the tracked script so a
# fix reaches every repo without re-seeding. Fails open: if the script is missing,
# the commit proceeds unmodified rather than being blocked.
f="$HOME/.config/git/strip-ai-trailers"
[ -x "$f" ] && exec "$f" "$@"
exit 0
